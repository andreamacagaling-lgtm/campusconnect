# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Google Sign-In (OAuth Web Client ID)
GOOGLE_OAUTH_CLIENT_ID=

# Gmail SMTP for general announcement emails
MAIL_USERNAME=
MAIL_PASSWORD=

# Google Calendar (service-account JSON file must be outside public/)
GOOGLE_CALENDAR_CREDENTIALS=
# Optional CA bundle PEM path; defaults to the system or Composer CA bundle
GOOGLE_CALENDAR_CA_BUNDLE=
GOOGLE_CALENDAR_TIMEZONE=Asia/Manila
GOOGLE_CALENDAR_CCS_ID=
GOOGLE_CALENDAR_CCJE_ID=
GOOGLE_CALENDAR_CBM_ID=
GOOGLE_CALENDAR_CAS_ID=
GOOGLE_CALENDAR_BTVTED_ID=
GOOGLE_CALENDAR_BSED_ID=

# SMTP notifications for USG event announcements
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CampusConnect
STUDENT_PORTAL_URL=http://localhost:5173/students/events